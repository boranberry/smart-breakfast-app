# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored — never commit real secrets.

# MySQL root password (also used by the backend to connect)
DB_PASSWORD=change_this_password

# Secret key used to sign JWTs. Must be a long, random string in any real
# deployment. Generate one with: openssl rand -base64 32
JWT_SECRET=change_this_to_a_long_random_string

# How long a login session lasts, in milliseconds (default: 24 hours)
JWT_EXPIRATION_MS=86400000
